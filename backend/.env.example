APP_NAME=HRMS API
APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hrms_db
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
FRONTEND_URL=http://localhost:5173
JWT_SECRET_KEY=generate_a_unique_random_secret_before_running
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional SMTP email notifications (leave blank to log notifications without sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
