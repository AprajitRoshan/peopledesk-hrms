{
  "info": {
    "name": "HRMS Day 1 APIs",
    "description": "Auth, employee, attendance, leave, dashboard and audit endpoints. Run Login Admin first; token is captured to collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        },
        {
          "name": "DB health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health/db"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().access_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"CHANGE_ME\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Admin check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/admin-check",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Employees (Admin)",
      "item": [
        {
          "name": "Create employee",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/employees",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Sample Employee\",\n  \"email\": \"employee@example.com\",\n  \"password\": \"ChangeMe123!\",\n  \"employee_code\": \"EMP001\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Software Engineer\",\n  \"phone\": \"9999999999\",\n  \"joining_date\": \"2026-10-12\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List employees",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/employees?limit=100",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Check in (Employee token)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/attendance/check-in",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ]
          }
        },
        {
          "name": "Check out (Employee token)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/attendance/check-out",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ]
          }
        },
        {
          "name": "My attendance (Employee token)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/attendance/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ]
          }
        },
        {
          "name": "All attendance (Admin)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/attendance",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Leave Management",
      "item": [
        {
          "name": "Apply for leave (Employee token)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/leaves",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start_date\": \"2026-10-20\",\n  \"end_date\": \"2026-10-21\",\n  \"leave_type\": \"annual\",\n  \"reason\": \"Personal commitments\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List leave (Admin)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/leaves?status=pending",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Approve leave (Admin)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/leaves/1/decision",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"review_note\": \"Approved\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Dashboards & Audit",
      "item": [
        {
          "name": "Admin dashboard",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/dashboard/admin",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Employee dashboard",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/dashboard/employee",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ]
          }
        },
        {
          "name": "Audit logs (read-only)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/audit-logs?limit=100",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Payroll (Day 2)",
      "item": [
        {
          "name": "List payroll records (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payroll?period={{payPeriod}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payroll"
              ],
              "query": [
                {
                  "key": "period",
                  "value": "{{payPeriod}}"
                }
              ]
            }
          }
        },
        {
          "name": "Process payroll with adjustment (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_id\": 1,\n  \"pay_period\": \"{{payPeriod}}\",\n  \"base_salary\": 50000,\n  \"allowances\": 5000,\n  \"deductions\": 2500,\n  \"adjustment_amount\": 1000,\n  \"adjustment_note\": \"Approved overtime adjustment\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/payroll",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payroll"
              ]
            }
          }
        },
        {
          "name": "Adjust processed salary (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"adjustment_amount\": 1500,\n  \"adjustment_note\": \"Approved payroll correction\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/payroll/{{payrollRecordId}}/adjustment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payroll",
                "{{payrollRecordId}}",
                "adjustment"
              ]
            }
          }
        },
        {
          "name": "My payroll records (Employee)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payroll/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payroll",
                "me"
              ]
            }
          }
        },
        {
          "name": "Download salary slip PDF (own record or Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payroll/{{payrollRecordId}}/salary-slip.pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payroll",
                "{{payrollRecordId}}",
                "salary-slip.pdf"
              ]
            }
          }
        },
        {
          "name": "Notification history (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payroll/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payroll",
                "notifications"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "employeeToken",
      "value": ""
    },
    {
      "key": "payPeriod",
      "value": "2026-10",
      "type": "default"
    },
    {
      "key": "payrollRecordId",
      "value": "1",
      "type": "default"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "default"
    }
  ]
}